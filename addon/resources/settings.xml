<?xml version="1.0" encoding="UTF-8"?>
<!-- Structure documented at: https://kodi.wiki/view/Add-on_settings_conversion -->
<settings version="1">
  <section id="script.example">
    <category id="general" label="32100">
      <group id="1" label="32101">
        <!-- Free-text field -->
        <setting id="username" type="string" label="32102" help="32112">
          <level>0</level>
          <default>World</default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string"/>
        </setting>
        <!-- Bounded integer -->
        <setting id="greeting_count" type="integer" label="32103" help="32113">
          <level>0</level>
          <default>3</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>10</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <!-- On/off toggle -->
        <setting id="excited" type="boolean" label="32104" help="32114">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <!-- Fixed choice list; the stored value is the option text, the shown
             label comes from strings.po -->
        <setting id="greeting_style" type="string" label="32105" help="32115">
          <level>0</level>
          <default>classic</default>
          <constraints>
            <options>
              <option label="32106">classic</option>
              <option label="32107">formal</option>
              <option label="32108">pirate</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
      </group>
    </category>
    <category id="advanced" label="32120">
      <group id="1" label="32121">
        <!-- Floating-point slider -->
        <setting id="pause_seconds" type="number" label="32122" help="32132">
          <level>0</level>
          <default>0.5</default>
          <constraints>
            <minimum>0.0</minimum>
            <step>0.1</step>
            <maximum>5.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <popup>false</popup>
          </control>
        </setting>
        <!-- Dependency demo: only visible while 'excited' is on -->
        <setting id="custom_suffix" type="string" label="32123" help="32133">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string"/>
          <dependencies>
            <dependency type="visible" setting="excited">true</dependency>
          </dependencies>
        </setting>
        <!-- Folder picker; level 2 = shown at Advanced settings level and up -->
        <setting id="export_path" type="path" label="32124" help="32134">
          <level>2</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
            <writable>true</writable>
          </constraints>
          <control type="button" format="path">
            <heading>32124</heading>
          </control>
        </setting>
        <!-- Action button: runs a Kodi builtin; $ID expands to the add-on id -->
        <setting id="rerun" type="action" label="32125" help="32135">
          <level>0</level>
          <data>RunScript($ID)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
