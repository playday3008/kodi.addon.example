<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Repository add-on: points Kodi at the GitHub Pages tree generated by
     scripts/repo.py. Version is hand-managed (bump on URL/layout changes);
     no build-time placeholders on purpose. -->
<addon
  id="repository.example"
  name="Example Repository"
  version="1.0.0"
  provider-name="playday3008"
>
  <requires>
    <import addon="xbmc.addon" version="21.0.0" />
  </requires>

  <extension point="xbmc.addon.repository" name="Example Repository">
    <dir>
      <info compressed="false">https://playday3008.github.io/kodi.addon.example/addons.xml</info>
      <checksum verify="sha256">https://playday3008.github.io/kodi.addon.example/addons.xml.sha256</checksum>
      <datadir>https://playday3008.github.io/kodi.addon.example/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Add-on repository for kodi.addon.example</summary>
    <description lang="en_GB">Serves the example add-on from GitHub Pages; installing this repository enables automatic updates.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/playday3008/kodi.addon.example</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
